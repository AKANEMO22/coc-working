{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LayaASRGateDecision",
  "type": "object",
  "properties": {
    "transcript_safe": {
      "type": "boolean"
    },
    "asr_gate_action": {
      "type": "string",
      "enum": [
        "ACCEPT_AS_IS",
        "ACCEPT_CORRECTION",
        "REQUEST_VERIFICATION",
        "ASK_CONFIRMATION"
      ]
    },
    "asr_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "required": ["transcript_safe", "asr_gate_action", "asr_confidence"],
  "additionalProperties": false
}
