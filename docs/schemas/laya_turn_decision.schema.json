{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LayaTurnDecision",
  "type": "object",
  "properties": {
    "answer_intent": {
      "type": "string",
      "enum": ["direct_answer", "clarification_question", "give_up", "irrelevant", "pause"]
    },
    "relevance": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "decision_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "next_action": {
      "type": "string",
      "enum": [
        "probe",
        "same_level",
        "harder",
        "easier",
        "switch_topic",
        "clarify_answer",
        "verify_reasoning",
        "finish_topic",
        "wrap_up",
        "finish_interview"
      ]
    },
    "difficulty_action": {
      "type": "string",
      "enum": ["increase", "maintain", "decrease"]
    },
    "escalate_to_strong_llm": {
      "type": "boolean"
    }
  },
  "required": ["answer_intent", "relevance", "decision_confidence", "next_action"],
  "additionalProperties": false
}
