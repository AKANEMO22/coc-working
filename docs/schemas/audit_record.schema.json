{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditRecord",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "laya_turn_decision",
        "laya_asr_decision",
        "laya_stream_decision",
        "evaluation"
      ]
    },
    "session_id": { "type": "string" },
    "turn_id": { "type": "string" },
    "model_version": { "type": "string" },
    "policy_version": { "type": "string" },
    "schema_version": { "type": "string" },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "input_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validation_status": {
      "type": "string",
      "enum": ["VALID", "INVALID", "PENDING"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_type",
    "session_id",
    "turn_id",
    "model_version",
    "policy_version",
    "schema_version",
    "confidence",
    "input_refs",
    "validation_status",
    "created_at"
  ],
  "additionalProperties": false
}
