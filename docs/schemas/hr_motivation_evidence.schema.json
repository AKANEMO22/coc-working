{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HRMotivation_EvaluationOutput",
  "type": "object",
  "properties": {
    "role_motivation_specificity": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "company_understanding_evidence": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "learning_goal_clarity": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "collaboration_example_quality": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "assessed_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "role_motivation_specificity",
          "company_understanding_evidence",
          "learning_goal_clarity",
          "collaboration_example_quality"
        ]
      },
      "uniqueItems": true
    },
    "observed_points": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missing_points": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "role_motivation_specificity",
    "company_understanding_evidence",
    "learning_goal_clarity",
    "collaboration_example_quality",
    "assessed_dimensions",
    "observed_points",
    "missing_points"
  ],
  "additionalProperties": false
}
