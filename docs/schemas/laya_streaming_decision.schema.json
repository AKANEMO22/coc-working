{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LayaStreamingDecision",
  "type": "object",
  "properties": {
    "stream_action": {
      "type": "string",
      "enum": [
        "CONTINUE",
        "AI_SOFT_INTERRUPT",
        "CLARIFY_NOW",
        "ASK_REPEAT",
        "END_TURN"
      ]
    },
    "stream_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "required": ["stream_action", "stream_confidence"],
  "additionalProperties": false
}
