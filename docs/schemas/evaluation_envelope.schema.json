{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvaluationEnvelope",
  "type": "object",
  "properties": {
    "turn_id": { "type": "string" },
    "rubric_type": {
      "type": "string",
      "enum": [
        "hr_motivation",
        "star_framework",
        "technical_correctness",
        "case_study"
      ]
    },
    "payload_schema": { "type": "string" },
    "evaluation_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "payload": { "type": "object" }
  },
  "required": [
    "turn_id",
    "rubric_type",
    "payload_schema",
    "evaluation_confidence",
    "payload"
  ],
  "additionalProperties": false
}
