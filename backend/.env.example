# ========================================
# CÓC ĐI LÀM — Backend Environment Config
# ========================================

# === Application ===
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:3000
# Default: <project>/data/normalized (resolved from source, independent of cwd).
# Override only when storing the dataset elsewhere:
# NORMALIZED_DATA_DIR=/absolute/path/to/data/normalized

# === Authentication Profile ===
# PILOT_DEMO = Guest Session + MSSV (demo/test)
# PRODUCTION = Supabase Auth (Google OAuth)
AUTH_PROFILE=PILOT_DEMO

# === Google Gemini AI ===
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-3.5-flash-lite
GEMINI_PRO_MODEL=gemini-3.5-flash-lite
INTERVIEW_GENERATION_TIMEOUT_SEC=12
INTERVIEW_QUESTION_TIMEOUT_SEC=12
INTERVIEW_CLARIFICATION_TIMEOUT_SEC=12
INTERVIEW_EVALUATION_TIMEOUT_SEC=20

# === Local speech models (no speech API key) ===
TTS_PROVIDER=vieneu
VIENEU_MODEL_ID=vieneu-v3-turbo
# Preset voice name from VieNeu-TTS v3 Turbo; e.g. Hải Đăng, Mai Anh, Trúc Ly.
VIENEU_VOICE=Hải Đăng
VIENEU_DEVICE=cuda
VIENEU_MAX_BATCH_SIZE=32
VIENEU_MAX_STREAMS=16
VIENEU_TEMPERATURE=0.8
VIENEU_TOP_K=25
VIENEU_TOP_P=0.95
STT_MODEL_ID=Qwen3-ASR-1.7B
STT_MODEL_PATH=Qwen/Qwen3-ASR-1.7B
# auto selects CUDA when available, otherwise CPU. Use cpu if GPU memory is tight.
STT_DEVICE=cuda
PRELOAD_LOCAL_SPEECH=true

# === Supabase (PostgreSQL 16 + pgvector) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# === Upstash Redis Serverless ===
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your_redis_token_here

# === Local Laya multilingual decision model (no API key / no per-request fee) ===
LAYA_ENABLED=true
LAYA_MODEL_PATH=convaiinnovations/laya-multilingual
LAYA_MODEL_REVISION=1720e3e3357cfe1e281542e223f8273b0890ca34
LAYA_DEVICE=cpu
LAYA_FAST=false

# === Session Config ===
SESSION_DEFAULT_DURATION_SEC=1500
SESSION_SCORED_QUESTION_BUDGET=8
SESSION_RECONNECT_TIMEOUT_SEC=120

# === Policy Versions ===
POLICY_VERSION=v1.0.0
SCHEMA_VERSION=v1.0.0
