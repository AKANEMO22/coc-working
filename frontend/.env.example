# ========================================
# CÓC ĐI LÀM — Frontend Environment Config
# ========================================

# URL Backend API & WebSocket
# Local: http://127.0.0.1:8000 (tránh localhost ưu tiên IPv6 ::1 khi server chỉ bind IPv4)
# Production: https://api.yourdomain.com (hoặc Render/Railway URL)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase Client (nếu gọi trực tiếp từ client side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Edge AI Models Storage CDN (tùy chọn nếu host model ngoài public)
NEXT_PUBLIC_MODELS_CDN_URL=/models
